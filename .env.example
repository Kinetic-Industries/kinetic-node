# Kinetic Node environment configuration
# Copy to .env and adjust as needed.

# Node identity (shown to browsers)
NODE_NAME=kin-node
NODE_DESC=A Kinetic Industries node

# Ports
KNET_PORT=8080
KEST_PORT=8443
ADMIN_PORT=4040

# Initial admin credentials — change on first login
ADMIN_USER=admin
ADMIN_PASS=change-me